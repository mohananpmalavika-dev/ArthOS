# Supabase configuration for server-side API persistence
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ASSESSMENTS_TABLE=assessments

# Optional local Postgres configuration instead of Supabase
DATABASE_URL=postgres://username:password@localhost:5432/arthos
PG_SSL=false
