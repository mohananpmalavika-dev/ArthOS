# ========================================
# SUPABASE CONFIGURATION
# ========================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ASSESSMENTS_TABLE=assessments

# ========================================
# ERROR MONITORING (Sentry)
# ========================================
# Leave empty to disable Sentry (falls back to localStorage logging)
# Get your DSN from: https://sentry.io/
VITE_SENTRY_DSN=https://your-project@sentry.io/project-id

# ========================================
# STRIPE CONFIGURATION
# ========================================
# Set these values from your Stripe dashboard:
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ========================================
# API CONFIGURATION
# ========================================
VITE_API_URL=http://localhost:5173/api

# ========================================
# GOOGLE OAUTH CONFIGURATION
# ========================================
# Set these values after creating a Google OAuth 2.0 credential.
# Redirect URI should point to the hosted callback route in your app.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional: if not set, redirect URI defaults to https://<host>/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# ========================================
# DATABASE CONFIGURATION (Optional)
# ========================================
# Use either Supabase (above) OR local Postgres (below), not both
DATABASE_URL=postgres://username:password@localhost:5432/arthos
PG_SSL=false

# ========================================
# LOCALE & CURRENCY CONFIGURATION
# ========================================
# Configurable locale for currency formatting (defaults to en-IN)
# Examples: en-IN, en-US, en-GB, de-DE, fr-FR, ja-JP
VITE_APP_LOCALE=en-IN
APP_LOCALE=en-IN

# Configurable currency code (defaults to INR)
# Examples: INR, USD, EUR, GBP, JPY
VITE_APP_CURRENCY=INR
APP_CURRENCY=INR
