# Copy to .env and fill values to enable DB persistence
# Example:
# DATABASE_URL=postgres://user:password@localhost:5432/arthos
# PG_SSL=false

DATABASE_URL=
PG_SSL=false

# Google OAuth requires a client ID + secret from Google Cloud Console.
# Example values go here to enable sign-in through Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
