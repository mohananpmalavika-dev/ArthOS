`;

exports[`FlowComponents > renders a highlight card with CTA and visual 1`] = `
<div
  class="flow-highlight-card"
>
  <div
    class="flow-highlight-content"
  >
    <h2>
      Actionable Insight
    </h2>
    <p>
      See the one change that most improves your next money move.
    </p>
    <p>
      Automated insights connect your spending, saving, and goals.
    </p>
    <button
      class="flow-highlight-cta"
    >
      Review plan
    </button>
  </div>
  <div
    class="flow-highlight-visual"
  >
    <div
      style="width: 80px; height: 80px; background: rgb(15, 23, 42);"
    />
  </div>
</div>
`;

