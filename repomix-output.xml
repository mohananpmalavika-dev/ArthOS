  box-shadow: 0 18px 45px rgba(109, 76, 255, 0.34);
}

.secondary-link {
  color: var(--text-2);
}

.engine-card {
  position: relative;
  display: grid;
  gap: 28px;
  min-height: 600px;
  padding: 52px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 48px 48px 0 0;
  background:
    linear-gradient(135deg, rgba(20, 23, 38, 0.98), rgba(17, 19, 33, 0.95) 46%, rgba(99, 68, 171, 0.8)),
    var(--surface);
  box-shadow: var(--shadow);
}

.engine-card::before {
  position: absolute;
  inset: auto 0 0;
  height: 44%;
  content: "";
  background: linear-gradient(180deg, transparent, rgba(139, 92, 246, 0.18));
  pointer-events: none;
}

.engine-card > * {
  position: relative;
}

.engine-chip {
  padding: 13px 20px;
  color: var(--text);
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.13);
}

.engine-metric {
  display: grid;
  gap: 14px;
  padding-top: 16px;
}

.engine-metric strong {
  color: var(--purple);
  font-family: var(--display);
  font-size: 98px;
  font-weight: 900;
  line-height: 0.9;
  letter-spacing: 0;
  text-shadow: 0 0 38px rgba(139, 92, 246, 0.35);
}

.engine-metric span {
  color: #efe9ff;
  font-size: 33px;
  font-weight: 760;
  line-height: 1.2;
}

.engine-list {
  display: grid;
  gap: 16px;
  margin-top: 12px;
}

.engine-list div {
  min-height: 64px;
  padding: 19px 22px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  color: var(--text);
  background: rgba(255, 255, 255, 0.045);
  font-size: 17px;
  font-weight: 760;
}

.engine-footer {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16px;
  margin-top: auto;
  padding-top: 10px;
}

.engine-footer span {
  color: var(--muted);
  font-size: 13px;
  font-weight: 850;
  text-transform: uppercase;
}

.engine-footer strong {
  color: var(--text);
  font-family: var(--display);
  font-size: 46px;
  line-height: 1;
}

.feature-section,
.business-section,
.founder-section,
.assessment-section {
  padding: 70px 0;
}

.feature-section,
.business-section,
.founder-section {
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.section-copy,
.business-section > h2,
.business-section > p {
  max-width: 1400px;
}

.section-copy h2,
.business-section h2,
.founder-section h2,
.assessment-heading h2 {
  color: var(--text);
  font-size: 58px;
  line-height: 1.05;
}

.section-copy p,
.business-section > p,
.founder-section > div > p,
.assessment-heading p {
  max-width: 1180px;
  margin-top: 24px;
  color: var(--muted);
  font-size: 21px;
  font-weight: 620;
  line-height: 1.7;
}

.intelligence-layout,
.founder-section {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(360px, 0.65fr);
  gap: 48px;
  align-items: center;
  margin-top: 46px;
}

.intelligence-list {
  display: grid;
  gap: 20px;
}

.intelligence-row {
  display: grid;
  grid-template-columns: 54px 1fr;
  align-items: center;
  gap: 22px;
  min-height: 96px;
  padding: 22px 24px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.055);
}

.intelligence-row svg {
  color: var(--cyan);
}

.intelligence-row h3,
.business-card h3 {
  color: var(--text);
  font-size: 20px;
  line-height: 1.2;
}

.intelligence-row p,
.business-card p {
  margin-top: 7px;
  color: var(--muted);
  font-size: 15px;
  font-weight: 620;
  line-height: 1.55;
}

.brain-frame {
  position: relative;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  min-height: 450px;
  padding: 56px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 44px;
  background:
    linear-gradient(135deg, rgba(26, 29, 46, 0.98), rgba(19, 22, 37, 0.98)),
    var(--surface);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.025);
}

.code-stack {
  display: grid;
  gap: 14px;
}

.code-stack span {
  display: block;
  height: 8px;
  border-radius: 999px;
  background: var(--cyan);
}

.code-stack span:nth-child(1),
.code-stack span:nth-child(5) {
  width: 70px;
}

.code-stack span:nth-child(2),
.code-stack span:nth-child(4) {
  width: 110px;
}

.code-stack span:nth-child(3) {
  width: 88px;
}

.brain-core {
  display: grid;
  width: 138px;
  aspect-ratio: 1;
  place-items: center;
  color: #ff5d7f;
  background: rgba(255, 93, 127, 0.12);
  border-radius: 42px;
}

.node-cluster {
  position: relative;
  width: 130px;
  height: 130px;
}

.node-cluster::before,
.node-cluster::after {
  position: absolute;
  left: 18px;
  width: 88px;
  height: 4px;
  border-radius: 999px;
  background: #4ea7ff;
  content: "";
}

.node-cluster::before {
  top: 32px;
}

.node-cluster::after {
  bottom: 32px;
}

.node-cluster i {
  position: absolute;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #f0c12f;
}

.node-cluster i:nth-child(1) {
  top: 24px;
  left: 10px;
}

.node-cluster i:nth-child(2) {
  top: 24px;
  right: 14px;
}

.node-cluster i:nth-child(3) {
  bottom: 24px;
  left: 10px;
}

.node-cluster i:nth-child(4) {
  right: 14px;
  bottom: 24px;
}

.business-section {
  border-radius: 44px;
  background:
    linear-gradient(100deg, rgba(37, 25, 66, 0.68), rgba(14, 19, 34, 0.78)),
    var(--surface-3);
  padding-right: clamp(28px, 4vw, 54px);
  padding-left: clamp(28px, 4vw, 54px);
}

.business-grid,
.founder-stats {
  display: grid;
  gap: 26px;
  margin-top: 48px;
}

.business-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.business-card,
.founder-stats div,
.founder-card,
.panel,
.result-card {
  border: 1px solid var(--border);
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.052);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
}

.business-card {
  min-height: 210px;
  padding: 34px;
}

.business-card:nth-child(3) {
  border-color: var(--border-strong);
}

.founder-section {
  align-items: stretch;
}

.founder-stats {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.founder-stats div {
  display: grid;
  gap: 12px;
  min-height: 132px;
  padding: 28px;
}

.founder-stats strong {
  color: var(--text);
  font-size: 21px;
}

.founder-stats span {
  color: var(--muted);
  font-size: 16px;
  font-weight: 650;
}

.founder-card {
  display: grid;
  align-content: center;
  gap: 24px;
  padding: 44px;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.035)),
    var(--surface);
}

.founder-card h3 {
  color: var(--text);
  font-size: 42px;
  line-height: 1.1;
}

.founder-card > span {
  color: var(--purple-2);
  font-size: 16px;
  font-weight: 900;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

.founder-card blockquote {
  color: var(--muted);
  font-size: 20px;
  font-weight: 680;
  line-height: 1.7;
}

.assessment-section {
  padding-bottom: 96px;
}

.assessment-heading {
  display: grid;
  gap: 20px;
  max-width: 1160px;
  margin-bottom: 44px;
}

.assessment-heading > span {
  padding: 12px 20px;
}

.assessment-heading h2 {
  font-size: 54px;
}

.workspace {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(360px, 0.75fr);
  gap: 30px;
  align-items: start;
}

.form-stack,
.result-stack {
  display: grid;
  align-content: start;
  gap: 18px;
}

.result-stack {
  position: sticky;
  top: 132px;
}

.panel {
  padding: clamp(22px, 3vw, 32px);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.035)),
    rgba(14, 18, 32, 0.96);
}

.result-card {
  padding: 26px;
  background:
    linear-gradient(180deg, rgba(45, 39, 67, 0.72), rgba(18, 22, 37, 0.94)),
    var(--surface);
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.panel-heading > div,
.result-heading,
.breakdown-row > div,
.money-pair,
.driver-grid {
  display: flex;
  align-items: center;
}

.panel-heading > div,
.result-heading {
  gap: 11px;
}

.panel-heading svg,
.result-heading svg,
.breakdown-row svg {
  flex: 0 0 auto;
  color: var(--cyan);
}

.panel-heading h2 {
  color: var(--text);
  font-size: 22px;
  line-height: 1.2;
}

.panel-heading > span {
  color: var(--text);
  border: 1px solid rgba(200, 155, 255, 0.32);
  border-radius: 999px;
  padding: 8px 12px;
  background: rgba(139, 92, 246, 0.24);
  font-size: 13px;
  font-weight: 900;
}

.question-list {
  display: grid;
  gap: 22px;
  padding-top: 24px;
}

.question-row {
  display: grid;
  grid-template-columns: minmax(190px, 0.75fr) minmax(340px, 1.25fr);
  gap: 18px;
  align-items: center;
}

.question-row.compact {
  padding-top: 22px;
}

.question-label,
.money-input > span {
  color: #f2efff;
  font-size: 14px;
  font-weight: 820;
  line-height: 1.4;
}

.segmented-control {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 7px;
  min-width: 0;
  padding: 6px;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.055);
}

.segmented-control .segmented-option {
  position: relative;
  min-height: 46px;
  min-width: 0;
  border-radius: 14px;
  color: #cdd4eb;
  background: transparent;
  font-size: 12px;
  font-weight: 820;
  line-height: 1.15;
  text-align: center;
  cursor: pointer;
  display: grid;
  place-items: center;
  padding: 0 12px;
}

.segmented-control .segmented-option input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.segmented-control .segmented-option:hover {
  color: var(--text);
  background: rgba(255, 255, 255, 0.08);
}

.segmented-control .segmented-option.selected {
  color: var(--text);
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.95), rgba(109, 76, 255, 0.72));
  box-shadow: 0 12px 30px rgba(109, 76, 255, 0.24);
}

.numeric-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 12px;
  padding-top: 24px;
}


.money-input {
  display: grid;
  gap: 9px;
}

.money-input > div {
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: center;
  min-height: 48px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.06);
}

.money-input > div > span {
  padding: 0 10px 0 13px;
  color: var(--purple-2);
  font-size: 11px;
  font-weight: 900;
}

.money-input input {
  width: 100%;
  min-width: 0;
  height: 46px;
  border: 0;
  outline: 0;
  color: var(--text);
  background: transparent;
  font-size: 15px;
  font-weight: 800;
}

.money-input input::-webkit-outer-spin-button,
.money-input input::-webkit-inner-spin-button {
  margin: 0;
}

.money-input:focus-within > div,
.segmented-control:focus-within {
  border-color: rgba(98, 228, 209, 0.72);
  box-shadow: 0 0 0 3px rgba(98, 228, 209, 0.13);
}

.score-card {
  display: grid;
  grid-template-columns: 1fr 136px;
  gap: 18px;
  overflow: hidden;
}

.score-copy {
  display: grid;
  align-content: center;
  gap: 8px;
}

.metric-label {
  color: var(--muted);
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
}

.score-copy h1 {
  color: var(--text);
  font-family: var(--display);
  font-size: 54px;
  font-weight: 900;
  line-height: 0.95;
}

.score-copy strong {
  width: fit-content;
  border: 1px solid rgba(200, 155, 255, 0.32);
  border-radius: 12px;
  padding: 8px 11px;
  color: var(--text);
  background: rgba(139, 92, 246, 0.24);
  font-size: 14px;
}

.tone-critical .score-copy strong {
  border-color: rgba(255, 111, 145, 0.44);
  color: #ffc8d4;
  background: rgba(255, 111, 145, 0.16);
}

.tone-warning .score-copy strong {
  border-color: rgba(244, 178, 85, 0.44);
  color: #ffd99d;
  background: rgba(244, 178, 85, 0.15);
}

.tone-steady .score-copy strong {
  border-color: rgba(98, 228, 209, 0.42);
  color: #c4fff6;
  background: rgba(98, 228, 209, 0.12);
}

.score-copy p {
  max-width: 30ch;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.5;
}

.score-dial {
  position: relative;
  display: grid;
  width: 136px;
  aspect-ratio: 1;
  place-items: center;
}

.score-dial svg {
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
}

.score-dial circle {
  fill: transparent;
  stroke-width: 12;
  stroke-linecap: round;
}

.score-dial .track {
  stroke: rgba(255, 255, 255, 0.12);
}

.score-dial .progress {
  stroke: var(--green);
}

.dial-critical .progress {
  stroke: var(--coral);
}

.dial-warning .progress {
  stroke: var(--amber);
}

.dial-steady .progress {
  stroke: var(--cyan);
}

.score-dial span {
  position: absolute;
  color: var(--text);
  font-family: var(--display);
  font-size: 27px;
  font-weight: 900;
}

.result-heading {
  padding-bottom: 15px;
}

.result-heading h2 {
  color: var(--text);
  font-size: 17px;
}

.breakdown-list {
  display: grid;
  gap: 18px;
}

.breakdown-row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 7px 12px;
}

.breakdown-row > div {
  gap: 8px;
  min-width: 0;
  color: var(--text);
  font-size: 14px;
  font-weight: 850;
}

.breakdown-row strong {
  color: var(--text);
  font-size: 13px;
}

.bar-track {
  grid-column: 1 / -1;
  height: 8px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.1);
}

.bar-track span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--cyan), var(--purple));
}

.breakdown-row small {
  grid-column: 1 / -1;
  color: var(--muted);
  font-size: 12px;
  font-weight: 720;
}

.survival-number {
  display: flex;
  align-items: baseline;
  gap: 8px;
  padding-top: 2px;
}

.survival-number strong {
  color: var(--text);
  font-family: var(--display);
  font-size: 44px;
  line-height: 0.95;
}

.survival-number span {
  color: var(--muted);
  font-size: 13px;
  font-weight: 850;
}

.status-line {
  padding-top: 7px;
  font-size: 14px;
  font-weight: 850;
}

.tone-text-critical {
  color: #ffc8d4;
}

.tone-text-warning {
  color: #ffd99d;
}

.tone-text-steady {
  color: #c4fff6;
}

.tone-text-strong {
  color: #c9ffe6;
}

.survival-rail {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
  padding-top: 17px;
}

.survival-rail span {
  height: 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.1);
}

.survival-rail span.active {
  background: linear-gradient(90deg, var(--cyan), var(--green));
}

.dual-survival-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 12px;
}

.dual-survival-grid > div {
  padding: 16px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.dual-survival-grid span {
  display: block;
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 8px;
}

.dual-survival-grid strong {
  color: var(--text);
  font-size: 24px;
  line-height: 1;
}

.money-pair {
  justify-content: space-between;
  gap: 12px;
  padding-top: 15px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 780;
}

.survival-insight-grid,
.future-risk-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 12px;
}

.survival-insight-grid > div,
.future-risk-grid > div,
.emergency-goal {
  padding: 16px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.survival-insight-grid span,
.future-risk-grid span,
.emergency-goal span {
  display: block;
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 8px;
}

.survival-insight-grid strong,
.future-risk-grid strong,
.emergency-goal strong {
  color: var(--text);
  font-size: 22px;
  line-height: 1.1;
}

.emergency-goal {
  display: grid;
  gap: 6px;
  margin-top: 12px;
}

.action-card p {
  color: var(--text);
  font-size: 20px;
  font-weight: 850;
  line-height: 1.32;
}

.driver-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 18px;
}

.driver-grid > div {
  display: grid;
  gap: 4px;
  padding: 13px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.04);
}

.driver-grid span {
  color: var(--muted);
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
}

.driver-grid strong {
  color: var(--text);
  font-size: 14px;
}

@media (max-width: 1320px) {
  .topbar {
    grid-template-columns: 1fr;
    gap: 18px;
    min-height: 0;
  }

  .nav-links,
  .toolbar {
    justify-content: flex-start;
  }

  .hero-section,
  .intelligence-layout,
  .founder-section,
  .workspace {
    grid-template-columns: 1fr;
  }

  .hero-section {
    min-height: auto;
  }

  .engine-card {
    min-height: 520px;
  }

  .result-stack {
    position: static;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .score-card {
    grid-column: 1 / -1;
  }
}

@media (max-width: 980px) {
  .hero-section,
  .feature-section,
  .business-section,
  .founder-section,
  .assessment-section {
    width: min(100% - 36px, 1750px);
  }

  .hero-copy h1 {
    font-size: 56px;
  }

  .section-copy h2,
  .business-section h2,
  .founder-section h2,
  .assessment-heading h2 {
    font-size: 42px;
  }

  .business-grid,
  .founder-stats,
  .numeric-grid,
  .result-stack {
    grid-template-columns: 1fr;
  }

  .question-row {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 720px) {
  .topbar {
    padding: 18px;
  }

  .logo-word {
    font-size: 34px;
  }

  .brand small {
    font-size: 11px;
    letter-spacing: 0.24em;
  }

  .nav-links {
    display: none;
  }

  .toolbar {
    flex-wrap: wrap;
  }

  .save-state {
    width: 100%;
    text-align: left;
  }

  .icon-button,
  .ghost-button {
    flex: 1 1 112px;
  }

  .hero-section {
    padding: 48px 0 42px;
  }

  .hero-copy h1 {
    font-size: 43px;
  }

  .hero-copy p,
  .section-copy p,
  .business-section > p,
  .founder-section > div > p,
