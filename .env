# ========================================
# AI PROVIDER SELECTION (Priority Order)
# ========================================
# Auto: HuggingFace → Together → Replicate → Mistral → Ollama → Claude → OpenAI
# Options: 'auto' (recommended), 'huggingface', 'together', 'replicate', 'mistral', 'ollama', 'claude', 'openai'
AI_PROVIDER=auto

# ========================================
# FREE AI PROVIDERS (No Credit Card - Recommended)
# ========================================

# 1. HUGGINGFACE (FREE) - Best for production on Vercel
# Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# 2. TOGETHER AI (FREE)
# Get key: https://www.together.ai (free credits for new users)
TOGETHER_API_KEY=

# 3. REPLICATE (FREE)
# Get key: https://replicate.com/api (free tier)
REPLICATE_API_KEY=

# 4. MISTRAL (FREE)
# Get key: https://console.mistral.ai (free tier available)
MISTRAL_API_KEY=

# ========================================
# OLLAMA CONFIGURATION (Completely Free - Local Only)
# ========================================
# Run Ollama locally for zero-cost AI: https://ollama.ai
# Installation: Download from https://ollama.ai
# Start server: ollama serve
# Pull models: ollama pull neural-chat (1.1GB) or ollama pull mistral (4GB)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=neural-chat

# ========================================
# PAID AI PROVIDERS (Requires Credit Card - Fallback Only)
# ========================================

# Claude (Requires credit card)
CLAUDE_API_KEY=

# OpenAI (Requires credit card)
OPENAI_API_KEY=

# ========================================
# LOCALE & CURRENCY CONFIGURATION
# ========================================
VITE_APP_LOCALE=en-IN
APP_LOCALE=en-IN
VITE_APP_CURRENCY=INR
APP_CURRENCY=INR

# ========================================
# REMINDERS CONFIGURATION
# ========================================
SUPABASE_REMINDERS_TABLE=reminders
SUPABASE_TELEMETRY_TABLE=anonymous_telemetry
SUPABASE_FEEDBACK_TABLE=tester_feedback
SUPABASE_ERROR_LOG_TABLE=error_logs
