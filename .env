# ========================================
# SUPABASE CONFIGURATION
# ========================================
# Get these from your Supabase dashboard: https://supabase.com/dashboard
# Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ASSESSMENTS_TABLE=assessments

# ========================================
# JWT SECRET
# ========================================
# Used for auth token signing/verification. CHANGE THIS in production.
JWT_SECRET=arthos-dev-secret-change-in-production

# ========================================
# ERROR MONITORING (Sentry)
# ========================================
# Leave empty to disable Sentry (falls back to localStorage logging)
VITE_SENTRY_DSN=

# ========================================
# API CONFIGURATION
# ========================================
VITE_API_URL=http://localhost:5173/api

# ========================================
# DATABASE CONFIGURATION (Optional)
# ========================================
# Use either Supabase (above) OR local Postgres (below), not both
# To use Postgres directly, uncomment and fill:
# DATABASE_URL=postgres://username:password@localhost:5432/arthos
# PG_SSL=false

# ========================================
# STRIPE CONFIGURATION (Optional)
# ========================================
# Leave empty to disable Stripe (subscriptions fall back to free tier)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_ID=price_plus_monthly

# ========================================
# OPENAI CONFIGURATION (Optional)
# ========================================
# Leave empty to disable AI Coach features
OPENAI_API_KEY=

# ========================================
# LOCALE & CURRENCY CONFIGURATION
# ========================================
VITE_APP_LOCALE=en-IN
APP_LOCALE=en-IN
VITE_APP_CURRENCY=INR
APP_CURRENCY=INR

# ========================================
# REMINDERS CONFIGURATION
# ========================================
SUPABASE_REMINDERS_TABLE=reminders
SUPABASE_TELEMETRY_TABLE=anonymous_telemetry
SUPABASE_FEEDBACK_TABLE=tester_feedback
SUPABASE_ERROR_LOG_TABLE=error_logs
